{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "sudo nixos-rebuild switch --show-trace --flake .#$hostname",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "echo": false,
                "showReuseMessage": false,
            }
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "nix-collect-garbage -d",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false,
                "echo": false,
                "showReuseMessage": false,
            }
        },
        {
            "label": "Update",
            "type": "shell",
            "command": "nix flake update",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false,
                "echo": false,
                "showReuseMessage": false,
            }
        }
    ]
}
